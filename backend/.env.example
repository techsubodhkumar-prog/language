# ==============================================================================
# Activity Discovery Platform - Backend Environment Configuration Example
# Copy this file to .env for local development. Never commit real credentials.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL & PostGIS Database (Planned for Milestone 1 & 2)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:placeholder_password@localhost:5432/activity_discovery?schema=public

# Supabase Auth Configuration (Planned for Milestone 1)
# Note: Never expose the Supabase service-role key in mobile or client code.
SUPABASE_URL=https://placeholder-project-ref.supabase.co
SUPABASE_ANON_KEY=placeholder_supabase_anon_key
SUPABASE_JWT_SECRET=placeholder_jwt_secret_for_token_verification

# Real-time WebSocket (Socket.IO) Configuration (Planned for Milestone 4)
CORS_ORIGIN=*
