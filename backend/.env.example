# ==============================================================================
# Activity Discovery Platform - Backend Environment Configuration Example
# Copy this file to .env for local development. Never commit real credentials.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL & PostGIS Database
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# Remote / Supabase connections automatically negotiate SSL with strict certificate verification.
DATABASE_URL=postgresql://postgres:placeholder_password@localhost:5432/activity_discovery?schema=public
# Set to 'false' only if connecting to an untrusted/self-signed database without a CA cert
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional custom CA certificate (inline PEM or file path)
DATABASE_CA_CERT=

# Supabase Auth Configuration
# Current Supabase projects use asymmetric ES256 signing keys verified via project JWKS.
SUPABASE_URL=https://placeholder-project-ref.supabase.co
SUPABASE_ANON_KEY=placeholder_supabase_anon_key
# Optional legacy symmetric HS256 secret. Omit when using Supabase project JWKS / Auth API.
SUPABASE_JWT_SECRET=

# Real-time WebSocket (Socket.IO) & CORS Configuration
# In production, set to your specific frontend domain(s) (comma-separated)
CORS_ORIGIN=*

# Optional Shared Secret for Scheduled Reminders
CRON_SECRET=

# Optional Push Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_SERVER_KEY=
