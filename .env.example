# ==============================================================================
# Activity Discovery Platform - Root Environment Template
# For service-specific configurations, see backend/.env.example
# ==============================================================================

# Backend API
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# PostgreSQL & PostGIS (Milestones 1 & 2)
DATABASE_URL=postgresql://postgres:placeholder_password@localhost:5432/activity_discovery?schema=public

# Supabase Auth (Milestone 1)
SUPABASE_URL=https://placeholder-project-ref.supabase.co
SUPABASE_ANON_KEY=placeholder_supabase_anon_key
# Optional legacy HS256 JWT signing secret. Prefer SUPABASE_URL + SUPABASE_ANON_KEY verification.
SUPABASE_JWT_SECRET=

# Mobile API Endpoint (for local Android emulator testing: 10.0.2.2:3000)
API_BASE_URL=http://localhost:3000/api/v1
